# Copy this file to .env — Docker Compose reads .env automatically, so these
# values get injected into the container without editing any tracked file.
# Set all four values below per machine (different on the UAV Pi vs the GCS
# laptop).

# Which role this machine plays — controls which tmux launcher and disros
# default get loaded (docker/bashrc.d/uav.sh or gcs.sh). Must be "uav" or
# "gcs".
ROLE=gcs

# IP address of the Raspberry Pi on the drone. It runs roscore; the GCS
# points ROS_MASTER_URI at this address by default (the UAV is its own
# master regardless of this value).
UAV_IP=

# IP address of the ground control station. Passed to MAVROS as gcs_url so
# QGroundControl / telemetry running there can connect over UDP.
GCS_IP=

# Motion-capture (Vicon) server address, passed to qutas_lab_450's
# environment.launch as vicon_server_dvp.
VICON_SERVER_DVP=10.68.42.85
