# Copy to .env to make distributed-ROS settings persistent.
# Docker Compose reads .env automatically; values exported in your shell win
# over it, so you can still override any of these per-command.

# Which machine runs roscore. Leave commented out to be the master yourself.
# Point it at the drone's companion computer, a teammate's laptop, or the lab
# ground station:
#ROS_MASTER_URI=http://192.168.0.42:11311

# The address YOUR nodes advertise to the rest of the ROS graph. Only needed
# when this machine is on more than one network (e.g. WiFi + VPN) and the
# wrong interface would otherwise be auto-selected.
#ROS_IP=192.168.0.166
