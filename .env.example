# Copy this file to .env — Docker Compose reads .env automatically, so these
# values get injected into the container without editing any tracked file.
# Set the three values below per machine (UAV Pi vs GCS laptop).

# IP address of the Raspberry Pi on the drone. It runs roscore, so both the
# UAV and the GCS point ROS_MASTER_URI at this address. Leave blank on the
# UAV itself if you'd rather it just use its own auto-detected IP.
UAV_IP=

# IP address of the ground control station. Passed to MAVROS as gcs_url so
# QGroundControl / telemetry running there can connect over UDP.
GCS_IP=

# Motion-capture (Vicon) server address, passed to qutas_lab_450's
# environment.launch as vicon_server_dvp.
VICON_SERVER_DVP=10.68.42.85
