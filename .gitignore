# ROS runtime state
.ros/
*.bag

# container-local state
docker/.cache/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# machine-specific distributed-ROS settings (generate with ./setup-env.sh)
.env
